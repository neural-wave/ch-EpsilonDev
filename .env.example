# REQUIRED FOR ACTUAL TWO-GROUP VERIFICATION (complete these in your private .env):
# 1. Copy this file to .env; keep .env and all real credentials out of git.
# 2. Set NL2SPARQL_BACKEND=llm, LLM_BASE_URL, LLM_QUERY_MODEL, and any required LLM_API_KEY.
#    The model must be an existing running open-source model; no GPU setup happens here.
# 3. Set VIRTUOSO_ENDPOINT to the existing dev database containing the actual patient graphs.
# 4. Export the edited settings before starting the API AND before running the verifier:
#       set -a
#       source .env
#       set +a
# 5. With that API already running, use its URL in --api-url:
#    python eval/validate_demo_results.py --execute --api-url http://127.0.0.1:8080 \
#      --case two_cohorts_diabetes_by_sex --browser
# Unit/browser fixtures do not replace this actual model + database verification.

# "stub": deterministic baselines, no model needed.
# "llm": OpenAI-compatible server (vLLM on the hackathon GPU, or Ollama locally).
NL2SPARQL_BACKEND=stub

# Vast.ai vLLM template: LLM_BASE_URL=https://<instance-ip>:<external-port-for-8000>/v1,
# LLM_API_KEY=<the instance's OPEN_BUTTON_TOKEN>, LLM_VERIFY_TLS=false (self-signed certificate).
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
LLM_QUERY_MODEL=
LLM_INTENT_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_VERIFY_TLS=true
# JSON merged into every LLM request. Qwen3.x needs thinking off, or it reasons until max_tokens:
# LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
LLM_EXTRA_BODY=

# Intent agent overrides. Empty = use the shared LLM_* value above (same server and model).
LLM_INTENT_BASE_URL=
LLM_INTENT_API_KEY=
# Leave unset to inherit LLM_EXTRA_BODY; set '{}' to send no extra fields to the intent model.
LLM_INTENT_EXTRA_BODY=
LLM_INTENT_MAX_TOKENS=200
LLM_QUERY_MAX_TOKENS=1500
# Context the query agent receives per request: similar examples, schema cards, code candidates.
CONTEXT_EXAMPLES=3
CONTEXT_CARDS=6
CONTEXT_CODES=5
# true: after the query agent, put typed code patterns first and lock the join order (Virtuoso speed).
QUERY_REORDER=true
# Prompt versions live in src/nl2sparql/agents/prompts.py
INTENT_PROMPT_VERSION=v4
QUERY_PROMPT_VERSION=v4

# Development only: profiling scripts, eval harness and the demo's optional dev check.
# The pipeline is database-agnostic: /nl-to-sparql never connects to it.
VIRTUOSO_ENDPOINT=http://localhost:8890/sparql

MAX_INPUT_CHARS=2000
MAX_RETRIES=1
# true: the retry feedback carries the rejected query. Measured worse (the model copies the broken query).
RETRY_WITH_PREVIOUS_QUERY=false
# Total time allowed for one API pipeline request, including retries (seconds).
REQUEST_TIMEOUT_SECONDS=75

# Run machine only (scripts/runbox.sh): SSH access to the GPU instance for the tunnel.
# With the tunnel up, use LLM_BASE_URL=http://localhost:18000/v1 and no token.
GPU_SSH_HOST=
GPU_SSH_PORT=
API_PORT=8080

# Hackathon: return the literal query of forbidden requests so the jury can judge it.
# Real use: false, and a forbidden request gets only the reason.
RETURN_NONCOMPLIANT_QUERY=true

# Demo only: disabled until organizers approve a minimum-group policy.
# Set a positive integer (e.g. 5) to enable conservative whole-result withholding.
DEMO_MIN_GROUP_SIZE=disabled

# Demo sharing: opt-in unlisted links expire after seven days.
# Only released questions/aggregate tables are persisted; never commit the database.
DEMO_SHARE_TTL_SECONDS=604800
# Default: logs/shared_results.sqlite3 (git-ignored).
# DEMO_SHARE_DB_PATH=

# Optional local reproducibility card. Blank values display as Not configured.
# Set these to the actual dataset identity; neither endpoint nor patient count is inferred.
# Example description: Development database, 2,000 patients, synthetic (only if accurate).
DEMO_DATASET_NAME=
DEMO_DATASET_VERSION=
DEMO_DATASET_DESCRIPTION=
# These fields and executed SPARQL remain local; they are excluded from shared snapshots.

# Public end-user console only: blocks judged/developer/docs endpoints and request archives.
# Requires an explicitly approved positive DEMO_MIN_GROUP_SIZE; never use this on the jury API.
# Authentication/TLS/network access controls remain the deployer's responsibility.
DEMO_PUBLIC_MODE=false
