# "stub": deterministic baselines, no model needed.
# "llm": OpenAI-compatible server (vLLM on the hackathon GPU, or Ollama locally).
NL2SPARQL_BACKEND=stub

LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
LLM_QUERY_MODEL=
LLM_INTENT_MODEL=
LLM_TIMEOUT_SECONDS=30

# Used by the demo page, the eval harness and the profiling scripts.
# The /nl-to-sparql endpoint itself never queries Virtuoso.
VIRTUOSO_ENDPOINT=http://localhost:8890/sparql

MAX_INPUT_CHARS=2000
MAX_RETRIES=1
